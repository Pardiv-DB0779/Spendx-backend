    <ProjectReference Include="..\GPC.Boost.SpendX.Repository\GPC.Boost.SpendX.Repository.csproj" />
    <ProjectReference Include="..\GPC.Boost.SpendX.Dto\GPC.Boost.SpendX.Dto.csproj" />
